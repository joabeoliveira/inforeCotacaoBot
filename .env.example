# HTTP API (wrapper para n8n) — apenas placeholders, nunca comite valores reais
PORT=3000
# URL pública desta API (usada no workflow do n8n; NÃO é a URL do painel do n8n)
# Exemplo de placeholder: https://SEU-ENDERECO-DA-API/api/quotes/search
INFORE_QUOTES_API_URL=

# Brave Search API token. Never commit the real value.
BRAVE_SEARCH_API_KEY=

# Optional overrides for local/integration testing.
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_TIMEOUT_MS=5000
BRAVE_SEARCH_MAX_RETRIES=2

# Serper API token. Never commit the real value.
SERPER_API_KEY=

# Optional overrides.
SERPER_API_URL=https://google.serper.dev/search
SERPER_TIMEOUT_MS=5000
SERPER_MAX_RETRIES=2
