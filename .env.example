# HTTP API (wrapper para n8n) — apenas placeholders, nunca comite valores reais
PORT=3000
# URL pública desta API (usada no workflow do n8n; NÃO é a URL do painel do n8n)
# Exemplo de placeholder: https://SEU-ENDERECO-DA-API/api/quotes/search
INFORE_QUOTES_API_URL=

# Segurança [A CONFIRMAR]: se definida, a API exige o header x-api-key
# (ou Authorization: Bearer <chave>). Vazia = endpoint aberto.
INFORE_QUOTES_API_KEY=
# Limite do corpo da requisição (bytes) e timeout de processamento (ms)
INFORE_MAX_BODY_BYTES=16384
INFORE_REQUEST_TIMEOUT_MS=15000

# Brave Search API token. Never commit the real value.
BRAVE_SEARCH_API_KEY=

# Optional overrides for local/integration testing.
BRAVE_SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
BRAVE_SEARCH_TIMEOUT_MS=5000
BRAVE_SEARCH_MAX_RETRIES=2
# Proteção do orçamento do Brave ($10/mês): máximo de itens validados por cotação
# e TTL do cache de validações (padrão: 24h)
BRAVE_VALIDATION_MAX_ITEMS=5
BRAVE_VALIDATION_CACHE_TTL_MS=86400000

# Serper API token. Never commit the real value.
SERPER_API_KEY=

# Optional overrides.
SERPER_API_URL=https://google.serper.dev/search
SERPER_TIMEOUT_MS=5000
SERPER_MAX_RETRIES=2
# Mercado dos resultados (padrão: Brasil / pt-br)
SERPER_GL=br
SERPER_HL=pt-br
# Opcional: localização geográfica, ex.: Rio de Janeiro, Brazil
SERPER_LOCATION=
